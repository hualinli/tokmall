# 仅作变量清单，不能直接用于生产。敏感值必须由部署平台的 Secret 注入。
APP_ENV=production
SERVER_PORT=8080

JWT_SECRET=replace-me-with-at-least-32-random-characters
FEED_CURSOR_SECRET=replace-me-with-a-different-random-secret

DB_HOST=postgres.internal
DB_PORT=5432
DB_USER=tokmall_app
DB_PASSWORD=replace-me
DB_DATABASE=tokmall
DB_SSL_MODE=verify-full

MINIO_ENDPOINT=objects.internal:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=tokmall-production
MINIO_USE_SSL=true

REDIS_ADDR=redis.internal:6379
REDIS_PASSWORD=replace-me
REDIS_DB=0
REDIS_USE_TLS=true

FEED_RANK_STRATEGY=time
FEED_CACHE_TTL=60s
FEED_CACHE_ENABLED=true
FEED_FOLLOWING_CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

ORDER_EXPIRY_WORKER_ENABLED=true
ORDER_EXPIRY_WORKER_INTERVAL=5s
ORDER_EXPIRY_WORKER_BATCH_SIZE=100
